// =====================================================
// DATASET LONGSOR PASIRLANGU - CISARUA - BANDUNG BARAT
// EVENT: JANUARI 2026
// DATA: SENTINEL-1 SAR + SRTM DEM + CHIRPS
// OUTPUT: CSV DATASET POLYGON LONGSOR + GEOJSON + RASTER
// =====================================================


// =====================================================
// 1. TITIK GROUND TRUTH / TITIK REFERENSI KEJADIAN
// Ganti titik ini dengan koordinat resmi BPBD/BNPB jika tersedia
// =====================================================

var groundTruth = ee.FeatureCollection([
  ee.Feature(ee.Geometry.Point([107.53694, -6.79722]), {name: 'Pasirlangu'}),
  ee.Feature(ee.Geometry.Point([107.53580, -6.80350]), {name: 'Pasir Kuning'}),
  ee.Feature(ee.Geometry.Point([107.53760, -6.80620]), {name: 'Babakan'}),
  ee.Feature(ee.Geometry.Point([107.53417, -6.82250]), {name: 'Pasir Halang'}),
  ee.Feature(ee.Geometry.Point([107.53180, -6.81200]), {name: 'Aliran Material Tengah'}),
  ee.Feature(ee.Geometry.Point([107.52890, -6.81750]), {name: 'Aliran Material Hilir'})
]);

var roi = groundTruth.geometry().buffer(5000);
var validationZone = groundTruth.geometry().buffer(1500);

Map.centerObject(roi, 13);
Map.setOptions('ROADMAP');


// =====================================================
// 2. PERIODE SEBELUM DAN SESUDAH KEJADIAN
// =====================================================

var beforeStart = '2025-12-15';
var beforeEnd   = '2026-01-23';

var afterStart  = '2026-01-24';
var afterEnd    = '2026-02-28';


// =====================================================
// 3. SENTINEL-1 SAR
// =====================================================

function getS1(startDate, endDate) {
  return ee.ImageCollection('COPERNICUS/S1_GRD')
    .filterBounds(roi)
    .filterDate(startDate, endDate)
    .filter(ee.Filter.eq('instrumentMode', 'IW'))
    .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VV'))
    .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VH'))
    .select(['VV', 'VH']);
}

var s1BeforeCol = getS1(beforeStart, beforeEnd);
var s1AfterCol  = getS1(afterStart, afterEnd);

print('Jumlah Sentinel-1 sebelum kejadian:', s1BeforeCol.size());
print('Jumlah Sentinel-1 sesudah kejadian:', s1AfterCol.size());

var s1Before = s1BeforeCol.median().clip(roi);
var s1After  = s1AfterCol.median().clip(roi);

var vvBefore = s1Before.select('VV').rename('VV_Before');
var vhBefore = s1Before.select('VH').rename('VH_Before');
var vvAfter  = s1After.select('VV').rename('VV_After');
var vhAfter  = s1After.select('VH').rename('VH_After');

var deltaVV = vvAfter.subtract(vvBefore).rename('Delta_VV');
var deltaVH = vhAfter.subtract(vhBefore).rename('Delta_VH');

var sarChange = deltaVV.abs()
  .add(deltaVH.abs())
  .rename('SAR_Change');


// =====================================================
// 4. DEM, SLOPE, ASPECT
// =====================================================

var dem = ee.Image('USGS/SRTMGL1_003')
  .clip(roi)
  .rename('Elevation');

var slope = ee.Terrain.slope(dem)
  .clip(roi)
  .rename('Slope');

var aspect = ee.Terrain.aspect(dem)
  .clip(roi)
  .rename('Aspect');


// =====================================================
// 5. CURAH HUJAN CHIRPS
// =====================================================

var rainfallJan = ee.ImageCollection('UCSB-CHG/CHIRPS/DAILY')
  .filterBounds(roi)
  .filterDate('2026-01-01', '2026-01-24')
  .sum()
  .clip(roi)
  .rename('Rainfall_Jan_1_23_2026');

var rainfallWeek = ee.ImageCollection('UCSB-CHG/CHIRPS/DAILY')
  .filterBounds(roi)
  .filterDate('2026-01-18', '2026-01-24')
  .sum()
  .clip(roi)
  .rename('Rainfall_Jan_18_23_2026');


// =====================================================
// 6. DETEKSI AREA LONGSOR
// =====================================================
// Kriteria ilmiah:
// 1. Perubahan SAR tinggi
// 2. Lereng curam
// 3. Dekat dengan zona ground truth
// 4. Noise kecil dibuang

var rawMask = sarChange.gt(3.0)
  .and(slope.gt(18))
  .and(ee.Image.constant(1).clip(validationZone).selfMask())
  .selfMask()
  .rename('Landslide_Raw');

var connected = rawMask.connectedPixelCount({
  maxSize: 100,
  eightConnected: true
});

// Minimal 30 piksel pada skala 10 m = sekitar 3.000 m2
var cleanMask = rawMask
  .updateMask(connected.gte(30))
  .focal_mode({
    radius: 1,
    units: 'pixels'
  })
  .selfMask()
  .toByte()
  .rename('Landslide_Label');


// =====================================================
// 7. DATASET IMAGE LENGKAP
// =====================================================

var datasetImage = ee.Image.cat([
  dem,
  slope,
  aspect,
  rainfallJan,
  rainfallWeek,
  vvBefore,
  vhBefore,
  vvAfter,
  vhAfter,
  deltaVV,
  deltaVH,
  sarChange,
  cleanMask.unmask(0).rename('Landslide_Label')
]).clip(roi);


// =====================================================
// 8. KONVERSI AREA MERAH MENJADI POLYGON
// =====================================================

var polygonRaw = cleanMask.reduceToVectors({
  geometry: validationZone,
  scale: 20,
  geometryType: 'polygon',
  eightConnected: true,
  labelProperty: 'Landslide_Label',
  maxPixels: 1e13,
  tileScale: 8
});

var polygonWithArea = polygonRaw.map(function(f) {
  var area = f.geometry().area(10);
  var centroid = f.geometry().centroid(10);
  var coord = centroid.coordinates();

  return f.set({
    Area_m2: area,
    Area_ha: ee.Number(area).divide(10000),
    Longitude: coord.get(0),
    Latitude: coord.get(1),
    Event_Date: '2026-01-24',
    Location: 'Pasirlangu - Cisarua - Bandung Barat',
    GroundTruth_Type: 'BPBD/BNPB/manual validation required',
    Data_Source: 'Sentinel-1 SAR, SRTM DEM, CHIRPS Rainfall'
  });
});

// Filter ilmiah: hanya polygon longsor yang cukup besar
var polygonFinal = polygonWithArea
  .filter(ee.Filter.gte('Area_m2', 5000))
  .sort('Area_m2', false)
  .limit(200);

print('Jumlah polygon final:', polygonFinal.size());
print('Preview 20 polygon final:', polygonFinal.limit(20));


// =====================================================
// 9. EKSTRAK NILAI RATA-RATA SETIAP POLYGON
// =====================================================

var datasetFinal = datasetImage.reduceRegions({
  collection: polygonFinal,
  reducer: ee.Reducer.mean(),
  scale: 20,
  tileScale: 8
});

print('Preview dataset final CSV:', datasetFinal.limit(20));


// =====================================================
// 10. TAMPILAN PETA MIRIP CONTOH
// =====================================================

Map.addLayer(
  cleanMask,
  {palette: ['red'], opacity: 0.90},
  'Area Longsor Terdeteksi'
);

Map.addLayer(
  groundTruth,
  {color: 'black', pointSize: 7},
  'Titik Ground Truth / Referensi'
);

Map.addLayer(
  ee.Image().paint(validationZone, 1, 2),
  {palette: ['blue']},
  'Zona Validasi'
);

Map.addLayer(
  ee.Image().paint(roi, 1, 2),
  {palette: ['black']},
  'Batas Area Kajian'
);


// =====================================================
// 11. EXPORT CSV DATASET LONGSOR FINAL
// =====================================================

Export.table.toDrive({
  collection: datasetFinal,
  description: 'CSV_Dataset_Longsor_Final_Pasirlangu_Cisarua_2026',
  folder: 'GEE_Landslide',
  fileNamePrefix: 'csv_dataset_longsor_final_pasirlangu_cisarua_2026',
  fileFormat: 'CSV'
});


// =====================================================
// 12. EXPORT POLYGON GEOJSON
// =====================================================

Export.table.toDrive({
  collection: polygonFinal,
  description: 'GeoJSON_Polygon_Longsor_Final_Pasirlangu_Cisarua_2026',
  folder: 'GEE_Landslide',
  fileNamePrefix: 'geojson_polygon_longsor_final_pasirlangu_cisarua_2026',
  fileFormat: 'GeoJSON'
});


// =====================================================
// 13. EXPORT RASTER AREA LONGSOR
// =====================================================

Export.image.toDrive({
  image: cleanMask,
  description: 'Raster_Area_Longsor_Final_Pasirlangu_Cisarua_2026',
  folder: 'GEE_Landslide',
  fileNamePrefix: 'raster_area_longsor_final_pasirlangu_cisarua_2026',
  region: roi,
  scale: 20,
  maxPixels: 1e13
});


// =====================================================
// 14. EXPORT RASTER DATASET LENGKAP
// =====================================================

Export.image.toDrive({
  image: datasetImage,
  description: 'Raster_Dataset_Lengkap_Pasirlangu_Cisarua_2026',
  folder: 'GEE_Landslide',
  fileNamePrefix: 'raster_dataset_lengkap_pasirlangu_cisarua_2026',
  region: roi,
  scale: 20,
  maxPixels: 1e13
});
